# daemon 只允许回环监听
HARNESS_HOST=127.0.0.1
HARNESS_PORT=4311
HARNESS_WEB_ORIGIN=http://127.0.0.1:5180
HARNESS_DATA_DIR=./data
HARNESS_WORKSPACE=./workspace
# pi = pi SDK 内核（默认）；builtin = 旧自建引擎
HARNESS_ENGINE=pi

# 不配置 API Key 时默认使用 Mock 模型，方便先把 UI 和工具链跑通
HARNESS_MOCK_MODEL=1
HARNESS_ANTHROPIC_API_KEY=
HARNESS_MODEL=claude-sonnet-5-5
HARNESS_MAX_TOKENS=16000

# 自动续轮上限（0 = 关闭）；模型只有显式要求自主迭代时才输出续轮标记
HARNESS_AUTO_FOLLOW_UP_MAX=8

# web_search 使用的 SearXNG 根地址（需启用 JSON 输出）；留空则工具返回配置提示
HARNESS_SEARXNG_URL=

# 可选：OpenAI-compatible /embeddings 端点；留空使用本地哈希向量
HARNESS_EMBEDDING_URL=
HARNESS_EMBEDDING_MODEL=text-embedding-3-small
HARNESS_EMBEDDING_DIMENSIONS=1536
HARNESS_EMBEDDING_API_KEY=

# SRT 沙箱需要脱敏的环境变量名（逗号分隔；留空不启用凭据脱敏）
HARNESS_SANDBOX_CREDENTIAL_NAMES=

# 子 Agent 预算（0 = 不限制 token/时长）
HARNESS_SUBAGENT_MAX_TOKENS=0
HARNESS_SUBAGENT_RUN_MAX_TOKENS=0
HARNESS_SUBAGENT_MAX_DURATION_MS=600000
HARNESS_SUBAGENT_RUN_MAX_DURATION_MS=0
HARNESS_SUBAGENT_MAX_TOTAL=12
HARNESS_SUBAGENT_MAX_DAG_NODES=12
